####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/NepTrek/bin || mkdir -p $(INSTALL_ROOT)/opt/NepTrek/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/NepTrek/bin/NepTrek.app
	
	$(QINSTALL) NepTrek.app $(INSTALL_ROOT)/opt/NepTrek/bin/NepTrek.app

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/NepTrek/bin/NepTrek.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/NepTrek/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

